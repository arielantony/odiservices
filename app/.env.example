# Copy to app/.env for local development. Never commit app/.env.
# Variable names only: no real values.

# Environment: dev or prod. Defaults to prod.
PORTAL_ENV=
# Log level: DEBUG, INFO, WARNING or ERROR. Defaults to INFO.
PORTAL_LOG_LEVEL=
# Cloudflare Access team domain, for example <team>.cloudflareaccess.com.
# Set together with PORTAL_ACCESS_AUD. Neither set: protected routes answer 503.
PORTAL_ACCESS_TEAM_DOMAIN=
# AUD tag of the Access application: 64 hexadecimal characters.
PORTAL_ACCESS_AUD=
# Postgres connection string: postgresql+psycopg://USER@HOST:PORT/DATABASE (a password may follow USER).
# A host that is not this machine needs ?sslmode=require. PORTAL_ENV=dev accepts a local host only.
# Unset: the server starts and nothing reads the database. make db-up uses
# postgresql+psycopg://odiservices@127.0.0.1:55432/odiservices
PORTAL_DATABASE_URL=
